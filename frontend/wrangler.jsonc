// Cloudflare deploy settings for the frontend.
// "single-page-application" makes QR links like /customer/menu?qr=... load the app
// instead of a 404 when opened directly on a phone.
{
  "name": "scander",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
